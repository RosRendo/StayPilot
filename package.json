{
  "name": "staypilot",
  "version": "1.0.0",
  "private": true,
  "description": "StayPilot — Multi-Tenant Hotel Booking & Management SaaS for Cambodia",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run prisma:seed --workspace=apps/api",
    "db:studio": "npm run prisma:studio --workspace=apps/api"
  },
  "keywords": [
    "hotel-booking",
    "saas",
    "cambodia",
    "nestjs",
    "nextjs",
    "prisma"
  ],
  "author": "StayPilot Team",
  "license": "UNLICENSED"
}
